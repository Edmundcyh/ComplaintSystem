# Database: set DATABASE_URL, or DB_USER and DB_PASSWORD
# (plus DB_HOST, DB_PORT and DB_NAME if they differ from the defaults below)
# DATABASE_URL=postgresql://user:password@localhost:5432/complaints
DB_USER=
DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=complaints

# Long random string used to sign login tokens
SECRET_KEY=

# AWS: S3 bucket for complaint photos, SES for emails
AWS_ACCESS_KEY=
AWS_SECRET=
AWS_BUCKET=
AWS_REGION=
SES_REGION=
# Sender address; must be verified in SES
SES_SENDER_EMAIL=

# Wise payments (sandbox shown; production is https://api.wise.com)
WISE_URL=https://api.wise-sandbox.com
WISE_API_KEY=
